[Unit]
Description=Winbind health probe and recovery
Documentation=https://github.com/NerdyGriffin/ansible-role-winbind_watchdog
After=winbind.service
Wants=winbind.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/winbind-watchdog.sh
# Probe + on-recovery debug-capture + recovery headroom (a wedged winbind can
# make each timeout-wrapped probe wait its full budget). Keep under the timer interval.
TimeoutStartSec=120
StandardError=journal
Nice=10
